{
  "name": "ai-model-generator-pipeline",
  "version": "1.0.0",
  "private": true,
  "description": "Cloud-native Kevin multi-lane image generation pipeline",
  "scripts": {
    "grok:build": "node memory/grok/scripts/grok-pipeline.js build --batch memory/grok/instagram-sexy-fits/batches/036-gen-z-day-scene-mix-jul02.md",
    "grok:gates": "node memory/grok/scripts/batch-gates.js memory/grok/instagram-sexy-fits/batches/036-gen-z-day-scene-mix-jul02.md",
    "orchestrator": "node services/orchestrator/server.js",
    "browser-pool": "GROK_PW_DRY_RUN=1 node services/browser-pool/server.js",
    "browser-pool:live": "GROK_PW_DRY_RUN=0 node services/browser-pool/server.js",
    "browser-pool:login": "bash scripts/chatgpt-login-mac.sh",
    "chatgpt:login-remote": "node scripts/remote-chatgpt-login.js",
    "chatgpt:verify": "node scripts/verify-chatgpt-session.js",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@browserbasehq/sdk": "^2.14.1",
    "playwright": "^1.49.0",
    "playwright-core": "^1.61.1"
  }
}
